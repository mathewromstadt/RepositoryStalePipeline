{
  "schemaVersion": "1.0",
  "trustedModules": [
    "Modules/Reporting/Adapters/Html/Html.psm1",
    "Modules/Reporting/Adapters/Grafana/Grafana.psm1"
  ],
  "adapters": [
    {
      "id": "html",
      "enabled": true,
      "module": "Modules/Reporting/Adapters/Html/Html.psm1",
      "failurePolicy": "FailPipeline",
      "settings": {
        "outputPath": "reports/branch-lifecycle.html"
      }
    },
    {
      "id": "grafana",
      "enabled": true,
      "module": "Modules/Reporting/Adapters/Grafana/Grafana.psm1",
      "failurePolicy": "Continue",
      "settings": {
        "metricsProtocol": "RemoteWrite",
        "metricsEndpointEnvironment": "METRICS_ENDPOINT",
        "metricsTokenEnvironment": "METRICS_TOKEN",
        "metricsUsernameEnvironment": "METRICS_USERNAME",
        "lokiEndpointEnvironment": "LOKI_ENDPOINT",
        "lokiTokenEnvironment": "LOKI_TOKEN",
        "lokiUsernameEnvironment": "LOKI_USERNAME",
        "retryCount": 2
      }
    }
  ]
}
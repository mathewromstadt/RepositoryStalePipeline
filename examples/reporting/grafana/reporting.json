{
  "schemaVersion": "1.0",
  "trustedModules": [
    "Modules/Reporting/Adapters/Html/Html.psm1",
    "Modules/Reporting/Adapters/Grafana/Grafana.psm1"
  ],
  "adapters": [
    {
      "id": "html",
      "enabled": true,
      "module": "Modules/Reporting/Adapters/Html/Html.psm1",
      "failurePolicy": "FailPipeline",
      "settings": {
        "outputPath": "reports/branch-lifecycle.html"
      }
    },
    {
      "id": "grafana",
      "enabled": true,
      "module": "Modules/Reporting/Adapters/Grafana/Grafana.psm1",
      "failurePolicy": "Continue",
      "settings": {
        "metricsEndpoint": "https://metrics.example.org/metrics/job/governance",
        "lokiEndpoint": "https://logs.example.org/loki/api/v1/push",
        "metricsTokenEnvironment": "GOVERNANCE_METRICS_TOKEN",
        "lokiTokenEnvironment": "GOVERNANCE_LOKI_TOKEN",
        "retryCount": 2
      }
    }
  ]
}
